# URL del backend FastAPI (en Vercel se carga como variable de entorno)
VITE_API_URL=http://localhost:8000

# Base de datos (en FastAPI Cloud se configura en el dashboard)
# Para desarrollo local usa SQLite (valor por defecto si no se define)
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# Orígenes permitidos para CORS (separados por coma, o * para todos)
# CORS_ORIGINS=https://tu-app.vercel.app,http://localhost:5173
